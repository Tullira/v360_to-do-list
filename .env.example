# Copie para .env e ajuste. O .env NAO e versionado (ver .gitignore).
#
#   cp .env.example .env
#
# Credenciais do container Postgres. Como o banco sobe do zero dentro do
# Docker, nos definimos a senha aqui - nao ha instalacao pre-existente
# com senha desconhecida para descobrir.
POSTGRES_USER=todo
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=to_do_list_development
POSTGRES_DB_TEST=to_do_list_test

# Porta exposta no host. 5433 e nao 5432 para nao conflitar com uma
# instalacao nativa de Postgres que ja esteja rodando na maquina.
DB_HOST_PORT=5433

# Porta do servidor Rails exposta no host.
APP_HOST_PORT=3000

# Chave usada para assinar os tokens JWT (HS256). Gere a sua com:
#   ruby -rsecurerandom -e "puts SecureRandom.hex(64)"
# Trocar este valor invalida todos os tokens ja emitidos.
SECRET_KEY_BASE=gere_a_sua_com_o_comando_acima
