# Imagem de DESENVOLVIMENTO/TESTE.
# O Dockerfile na raiz e o de producao gerado pelo Rails - nao mexa nele
# para rodar a suite; ele instala apenas o grupo default de gems.
ARG RUBY_VERSION=3.4.9
FROM docker.io/library/ruby:$RUBY_VERSION-slim

WORKDIR /rails

# build-essential + libpq-dev: compilar as extensoes nativas (pg, bcrypt).
# postgresql-client: da o pg_isready/psql usados para esperar o banco subir.
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y \
      build-essential \
      git \
      libpq-dev \
      libyaml-dev \
      postgresql-client \
      # chromium: o Cuprite dirige um Chrome headless de verdade nos
      # testes de sistema; a imagem slim nao traz navegador algum.
      chromium \
      fonts-liberation && \
    rm -rf /var/lib/apt/lists/*

ENV BROWSER_PATH=/usr/bin/chromium

ENV RAILS_ENV=development \
    BUNDLE_PATH=/usr/local/bundle \
    # vazio de proposito: precisamos dos grupos development e test
    BUNDLE_WITHOUT=""

# Instala as gems antes de copiar o codigo, para que uma mudanca em app/
# nao invalide a camada de bundle install.
COPY Gemfile Gemfile.lock ./
RUN bundle install && \
    rm -rf "${BUNDLE_PATH}"/ruby/*/cache

COPY . .

EXPOSE 3000

CMD ["bin/rails", "server", "-b", "0.0.0.0", "-p", "3000"]
