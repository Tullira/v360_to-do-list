<div class="mx-auto mt-16 w-full max-w-sm">
  <div class="card p-6">
    <h1 class="text-xl font-semibold tracking-tight text-slate-900">Entrar</h1>
    <p class="mt-1 text-sm text-slate-500">Acesse suas listas.</p>

    <%= form_with url: login_path, method: :post, class: "mt-6 space-y-4" do |f| %>
      <div>
        <%= f.label :email, "Email", class: "field-label" %>
        <%= f.email_field :email, autocomplete: "email", autofocus: true, class: "field" %>
      </div>

      <div>
        <%= f.label :password, "Senha", class: "field-label" %>
        <%= f.password_field :password, autocomplete: "current-password", class: "field" %>
      </div>

      <%= f.submit "Entrar", class: "btn btn-primary w-full" %>
    <% end %>
  </div>

  <p class="mt-6 text-center text-sm text-slate-600">
    Ainda nao tem conta?
    <%= link_to "Criar conta", signup_path, class: "font-medium text-indigo-600 hover:text-indigo-500" %>
  </p>
</div>
