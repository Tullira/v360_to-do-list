<%= render layout: "shared/auth",
           locals: { title: "Entrar",
                     subtitle: "Acesse suas listas.",
                     footer_text: "Ainda nao tem conta?",
                     footer_link_label: "Criar conta",
                     footer_link_path: signup_path } do %>
  <%# Sem form_with model:: o SessionsController nao expoe um @user, e a
      mensagem de erro chega por flash.now[:alert], nao por errors do
      registro. Ver a invariante de login que nao revela e-mails existentes. %>
  <%= form_with url: login_path, method: :post, class: "space-y-4" do |f| %>
    <div>
      <%= f.label :email, "Email", class: "field-label" %>
      <%= f.email_field :email, autocomplete: "email", autofocus: true, class: "field" %>
    </div>

    <div>
      <%= f.label :password, "Senha", class: "field-label" %>
      <%= f.password_field :password, autocomplete: "current-password", class: "field" %>
    </div>

    <%= f.submit "Entrar", class: "btn btn-primary mt-2 w-full" %>
  <% end %>
<% end %>
