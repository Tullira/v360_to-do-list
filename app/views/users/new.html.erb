<%= render layout: "shared/auth",
           locals: { title: "Criar conta",
                     subtitle: "Leva menos de um minuto.",
                     footer_text: "Ja tem conta?",
                     footer_link_label: "Entrar",
                     footer_link_path: login_path } do %>
  <%= form_with model: @user, url: signup_path, method: :post, class: "space-y-4" do |f| %>
    <%= render "shared/errors", record: @user %>

    <div>
      <%= f.label :username, "Usuario", class: "field-label" %>
      <%= f.text_field :username, autocomplete: "username", autofocus: true, class: "field" %>
    </div>

    <div>
      <%= f.label :email, "Email", class: "field-label" %>
      <%= f.email_field :email, autocomplete: "email", class: "field" %>
    </div>

    <div>
      <%= f.label :password, "Senha", class: "field-label" %>
      <%= f.password_field :password, autocomplete: "new-password", class: "field" %>
      <p class="field-hint">Minimo de 8 caracteres.</p>
    </div>

    <%= f.submit "Criar conta", class: "btn btn-primary mt-2 w-full" %>
  <% end %>
<% end %>
