<div class="mx-auto mt-10 w-full max-w-md">
  <nav class="mb-4 text-sm">
    <%= link_to "Minhas listas", lists_path, class: "text-slate-500 hover:text-slate-900" %>
  </nav>

  <div class="card p-6">
    <h1 class="text-xl font-semibold tracking-tight text-slate-900">Renomear lista</h1>

    <%= form_with model: @list, url: list_path(@list), method: :patch, class: "mt-6 space-y-4" do |f| %>
      <%= render "shared/errors", record: @list %>

      <div>
        <%= f.label :name, "Nome da lista", class: "field-label" %>
        <%= f.text_field :name, autofocus: true, class: "field" %>
      </div>

      <div class="flex items-center justify-end gap-2 pt-2">
        <%= link_to "Cancelar", lists_path, class: "btn btn-secondary" %>
        <%= f.submit "Salvar", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</div>
