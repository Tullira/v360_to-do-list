<div class="mx-auto mt-10 w-full max-w-md">
  <h1 class="mb-6 text-2xl font-semibold text-slate-900">Renomear lista</h1>

  <%= render "shared/errors", record: @list %>

  <%= form_with model: @list, url: list_path(@list), method: :patch, class: "space-y-4" do |f| %>
    <div>
      <%= f.label :name, "Nome da lista", class: "block text-sm font-medium text-slate-700" %>
      <%= f.text_field :name,
            class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" %>
    </div>

    <div class="flex items-center gap-3">
      <%= f.submit "Salvar", class: "cursor-pointer rounded-md bg-slate-900 px-4 py-2 font-medium text-white hover:bg-slate-700" %>
      <%= link_to "Cancelar", lists_path, class: "text-sm text-slate-600 hover:underline" %>
    </div>
  <% end %>
</div>
