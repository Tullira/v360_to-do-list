<% pendentes = @tasks.count { |t| !t.completed? } %>

<div class="page">
  <nav class="mb-4 text-sm">
    <%= link_to lists_path, class: "inline-flex items-center gap-1 text-fg-muted transition-colors hover:text-fg" do %>
      <%= render "shared/icon", name: "chevron-left", class: "size-4" %>
      Minhas listas
    <% end %>
  </nav>

  <%= render layout: "shared/page_header",
             locals: { title: @list.name,
                       subtitle: @tasks.empty? ? "Nenhuma tarefa" : "#{pluralize(pendentes, "tarefa pendente", plural: "tarefas pendentes")} de #{@tasks.size}" } do %>
    <%= render layout: "shared/modal",
               locals: { trigger: "Nova tarefa",
                         title: "Nova tarefa",
                         subtitle: "Descreva o que precisa ser feito.",
                         open: @task.errors.any? } do %>
      <%= form_with model: [ @list, @task ], url: list_tasks_path(@list), method: :post, class: "space-y-4" do |f| %>
        <%= render "shared/errors", record: @task %>

        <div>
          <%= f.label :title, "Titulo", class: "field-label" %>
          <%= f.text_field :title, autofocus: true, placeholder: "Ex.: Comprar leite", class: "field" %>
        </div>

        <div>
          <%= f.label :description, "Descricao", class: "field-label" %>
          <%= f.text_area :description, rows: 3,
                placeholder: "Detalhes que ajudam na hora de fazer", class: "field" %>
          <p class="field-hint">Opcional.</p>
        </div>

        <div>
          <%= f.label :due_date, "Prazo", class: "field-label" %>
          <%= f.date_field :due_date, class: "field" %>
        </div>

        <div class="flex justify-end gap-2 pt-1">
          <button type="button" class="btn btn-secondary" data-action="dialog#close">Cancelar</button>
          <%= f.submit "Adicionar", class: "btn btn-primary" %>
        </div>
      <% end %>
    <% end %>
  <% end %>

  <% if @tasks.empty? %>
    <%= render "shared/empty_state",
               icon: "check",
               title: "Nenhuma tarefa por aqui",
               hint: 'Clique em "Nova tarefa" para adicionar a primeira.' %>
  <% else %>
    <ul class="card row-divide">
      <% @tasks.each do |task| %>
        <li class="row" data-completed="<%= task.completed %>">
          <%# Sem botao de submit: o Stimulus envia o formulario na mudanca. A
              label fica sr-only, nunca hidden - `check "Concluida"` precisa
              encontra-la. %>
          <%= form_with model: [ @list, task ], url: list_task_path(@list, task), method: :patch,
                        class: "pt-0.5",
                        data: { controller: "autosubmit", action: "change->autosubmit#submit" } do |f| %>
            <%= f.check_box :completed,
                  id: "task_#{task.id}_completed",
                  class: "checkbox" %>
            <%= f.label :completed, "Concluida", for: "task_#{task.id}_completed", class: "sr-only" %>
          <% end %>

          <div class="min-w-0 flex-1">
            <%= link_to task.title, list_task_path(@list, task),
                  class: class_names("block truncate font-medium transition-colors hover:text-accent-text",
                                     "text-fg-subtle line-through" => task.completed?,
                                     "text-fg" => !task.completed?) %>

            <% if task.description.present? %>
              <p class="mt-0.5 truncate text-sm text-fg-muted"><%= task.description %></p>
            <% end %>

            <% if task.due_date.present? %>
              <div class="mt-1.5">
                <%= render "shared/task_due_date", date: task.due_date, completed: task.completed? %>
              </div>
            <% end %>
          </div>

          <div class="flex shrink-0 items-center gap-1">
            <%= link_to "Editar", edit_list_task_path(@list, task), class: "btn btn-ghost" %>
            <%= button_to "Excluir tarefa", list_task_path(@list, task), method: :delete,
                  form_class: "inline-block", class: "btn btn-danger" %>
          </div>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
