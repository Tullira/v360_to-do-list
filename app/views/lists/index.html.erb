<div class="mx-auto mt-10 w-full max-w-2xl">
  <div class="mb-6 flex items-end justify-between gap-4">
    <div>
      <h1 class="text-2xl font-semibold tracking-tight text-slate-900">Minhas listas</h1>
      <p class="mt-1 text-sm text-slate-500"><%= pluralize(@lists.size, "lista") %></p>
    </div>

    <%= render layout: "shared/modal",
               locals: { trigger: "Nova lista",
                         title: "Nova lista",
                         subtitle: "De um nome para agrupar suas tarefas.",
                         open: @list.errors.any? } do %>
      <%= form_with model: @list, url: lists_path, method: :post, class: "space-y-4" do |f| %>
        <%= render "shared/errors", record: @list %>

        <div>
          <%= f.label :name, "Nome da lista", class: "field-label" %>
          <%= f.text_field :name, autofocus: true, placeholder: "Ex.: Mercado", class: "field" %>
        </div>

        <div class="flex justify-end gap-2 pt-1">
          <button type="button" class="btn btn-secondary" data-action="dialog#close">Cancelar</button>
          <%= f.submit "Criar lista", class: "btn btn-primary" %>
        </div>
      <% end %>
    <% end %>
  </div>

  <% if @lists.empty? %>
    <div class="card p-10 text-center">
      <%= render "shared/icon", name: "list", class: "mx-auto size-10 text-slate-300" %>
      <h2 class="mt-4 font-medium text-slate-900">Voce ainda nao tem listas</h2>
      <p class="mt-1 text-sm text-slate-500">Clique em "Nova lista" para criar a primeira.</p>
    </div>
  <% else %>
    <ul class="card divide-y divide-slate-100">
      <% @lists.each do |list| %>
        <% total = list.tasks.size %>
        <% concluidas = list.tasks.count(&:completed?) %>
        <li class="flex items-center justify-between gap-4 px-4 py-3 transition-colors hover:bg-slate-50">
          <div class="min-w-0">
            <%= link_to list.name, list_path(list),
                  class: "block truncate font-medium text-slate-900 hover:text-indigo-600" %>
            <p class="mt-0.5 text-xs text-slate-500">
              <% if total.zero? %>
                Sem tarefas
              <% else %>
                <%= concluidas %> de <%= pluralize(total, "tarefa") %> concluidas
              <% end %>
            </p>
          </div>

          <div class="flex shrink-0 items-center gap-1">
            <%= link_to "Editar", edit_list_path(list), class: "btn btn-ghost" %>
            <%= button_to "Excluir", list_path(list), method: :delete,
                  form_class: "inline-block", class: "btn btn-danger" %>
          </div>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
