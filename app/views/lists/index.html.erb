<div class="page">
  <%# @lists.length, e nao .size: a relacao vem agrupada (ver
      ListsController#lists_with_counts) e `size` numa relacao agrupada ainda
      nao carregada devolve um Hash de contagens por id, nao um numero.
      `length` carrega as linhas e conta o array. %>
  <%= render layout: "shared/page_header",
             locals: { title: "Minhas listas",
                       subtitle: pluralize(@lists.length, "lista") } do %>
    <%= render layout: "shared/modal",
               locals: { trigger: "Nova lista",
                         title: "Nova lista",
                         subtitle: "De um nome para agrupar suas tarefas.",
                         open: @list.errors.any? } do %>
      <%= form_with model: @list, url: lists_path, method: :post, class: "space-y-4" do |f| %>
        <%= render "shared/errors", record: @list %>

        <div>
          <%= f.label :name, "Nome da lista", class: "field-label" %>
          <%= f.text_field :name, autofocus: true, placeholder: "Ex.: Mercado", class: "field" %>
        </div>

        <div class="flex justify-end gap-2 pt-1">
          <button type="button" class="btn btn-secondary" data-action="dialog#close">Cancelar</button>
          <%= f.submit "Criar lista", class: "btn btn-primary" %>
        </div>
      <% end %>
    <% end %>
  <% end %>

  <% if @lists.empty? %>
    <%= render "shared/empty_state",
               icon: "list",
               title: "Voce ainda nao tem listas",
               hint: 'Clique em "Nova lista" para criar a primeira.' %>
  <% else %>
    <ul class="card row-divide">
      <% @lists.each do |list| %>
        <%# Agregados no banco por ListsController#lists_with_counts. %>
        <% total = list.tasks_count %>
        <% concluidas = list.completed_count %>
        <li class="row items-center justify-between">
          <div class="min-w-0 flex-1">
            <%= link_to list.name, list_path(list),
                  class: "block truncate font-medium text-fg transition-colors hover:text-accent-text" %>

            <div class="mt-1.5 flex items-center gap-2.5">
              <% if total.zero? %>
                <p class="meta">Sem tarefas</p>
              <% else %>
                <%# O valor vai em atributo, nao em style="width:X%": estilo
                    inline conflitaria com a CSP planejada em SEGURANCA.md.
                    aria-hidden porque o texto ao lado ja diz o mesmo. %>
                <progress class="progress w-20 shrink-0"
                          value="<%= concluidas %>" max="<%= total %>" aria-hidden="true"></progress>
                <p class="meta truncate"><%= concluidas %> de <%= pluralize(total, "tarefa") %> concluidas</p>
              <% end %>
            </div>
          </div>

          <div class="flex shrink-0 items-center gap-1">
            <%= link_to "Editar", edit_list_path(list), class: "btn btn-ghost" %>
            <%= button_to "Excluir", list_path(list), method: :delete,
                  form_class: "inline-block", class: "btn btn-danger" %>
          </div>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
