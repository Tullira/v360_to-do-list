<%# Pagina 404.

    Precisa continuar ESTATICA. spec/requests/authorization_spec.rb compara
    [status, body] de um recurso de outro usuario com os de um id inexistente
    usando `eq`: as duas respostas tem de ser identicas byte a byte, ou daria
    para enumerar os recursos alheios pela diferenca. Nada de id pedido, nome
    do recurso, timestamp ou nonce aqui dentro.
%>
<div class="mx-auto mt-24 max-w-md px-4 text-center">
  <span class="mx-auto flex size-12 items-center justify-center rounded-full bg-surface-sunken text-fg-subtle">
    <%= render "shared/icon", name: "face-frown", class: "size-6" %>
  </span>

  <h1 class="mt-4 text-2xl font-semibold tracking-tight text-fg">Recurso nao encontrado</h1>
  <p class="mt-2 text-fg-muted">
    O item que voce procurou nao existe ou nao esta disponivel.
  </p>

  <%= link_to "Voltar para minhas listas", lists_path, class: "btn btn-primary mt-6" %>
</div>
