    "Voce ainda nao tem listas" e "Nenhuma tarefa por aqui" literalmente.

    Locais: icon, title, hint.
%>
<div class="card px-6 py-14 text-center">
  <span class="mx-auto flex size-12 items-center justify-center rounded-full bg-surface-sunken text-fg-subtle">
    <%= render "shared/icon", name: icon, class: "size-6" %>
