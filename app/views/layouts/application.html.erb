<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title><%= content_for(:title) || "To-do list" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-slate-50 text-slate-900 antialiased">
    <header class="border-b border-slate-200 bg-white">
      <nav class="mx-auto flex max-w-2xl items-center justify-between px-4 py-3">
        <%= link_to "To-do list", root_path, class: "font-semibold text-slate-900" %>

        <% if signed_in? %>
          <div class="flex items-center gap-4 text-sm">
            <span class="text-slate-600"><%= current_user.username %></span>
            <%= button_to "Sair", logout_path, method: :delete,
                  class: "cursor-pointer rounded-md border border-slate-300 px-3 py-1 hover:bg-slate-100" %>
          </div>
        <% else %>
          <div class="flex items-center gap-4 text-sm">
            <%= link_to "Entrar", login_path, class: "text-slate-600 hover:underline" %>
            <%= link_to "Criar conta", signup_path, class: "text-slate-600 hover:underline" %>
          </div>
        <% end %>
      </nav>
    </header>

    <% if flash[:alert].present? %>
      <div class="mx-auto mt-4 max-w-2xl rounded-md border border-red-300 bg-red-50 px-4 py-2 text-sm text-red-800">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <% if flash[:notice].present? %>
      <div class="mx-auto mt-4 max-w-2xl rounded-md border border-green-300 bg-green-50 px-4 py-2 text-sm text-green-800">
        <%= flash[:notice] %>
      </div>
    <% end %>

    <main class="px-4 pb-16">
      <%= yield %>
    </main>
  </body>
</html>
