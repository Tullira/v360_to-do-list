<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title><%= content_for(:title) || "To-do list" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <%# data-turbo-prefetch="false": o Turbo busca o link no hover e reaproveita
      essa resposta na navegacao seguinte. Uma pagina capturada antes de um
      flash existir e exibida sem ele - e isso o servidor nao tem como
      corrigir. Com paginas de poucos milissegundos o prefetch nao paga esse
      preco. Reative por link com data-turbo-prefetch="true" se algum dia
      alguma pagina ficar cara. Ver ApplicationController para a protecao que
      continua valendo do lado do servidor. %>
  <body class="min-h-screen bg-slate-50 text-slate-900 antialiased" data-turbo-prefetch="false">
    <header class="sticky top-0 z-10 border-b border-slate-200 bg-white/80 backdrop-blur">
      <nav class="mx-auto flex max-w-2xl items-center justify-between gap-4 px-4 py-3">
        <%= link_to root_path, class: "flex items-center gap-2 font-semibold tracking-tight text-slate-900" do %>
          <span class="flex size-7 items-center justify-center rounded-lg bg-indigo-600 text-white">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
            </svg>
          </span>
          To-do list
        <% end %>

        <% if signed_in? %>
          <div class="flex items-center gap-3 text-sm">
            <span class="hidden text-slate-500 sm:inline"><%= current_user.username %></span>
            <%= button_to "Sair", logout_path, method: :delete,
                  form_class: "inline-block", class: "btn btn-secondary" %>
          </div>
        <% else %>
          <div class="flex items-center gap-2 text-sm">
            <%= link_to "Entrar", login_path, class: "btn btn-ghost" %>
            <%= link_to "Criar conta", signup_path, class: "btn btn-primary" %>
          </div>
        <% end %>
      </nav>
    </header>

    <% if flash[:alert].present? %>
      <div class="mx-auto mt-4 flex max-w-2xl items-start gap-2 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
        <svg class="mt-0.5 size-4 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path d="M10 2a8 8 0 1 0 0 16 8 8 0 0 0 0-16Zm0 4a1 1 0 0 1 1 1v3a1 1 0 1 1-2 0V7a1 1 0 0 1 1-1Zm0 8.5a1.25 1.25 0 1 1 0-2.5 1.25 1.25 0 0 1 0 2.5Z" />
        </svg>
        <%= flash[:alert] %>
      </div>
    <% end %>

    <% if flash[:notice].present? %>
      <div class="mx-auto mt-4 flex max-w-2xl items-start gap-2 rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800">
        <svg class="mt-0.5 size-4 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path d="M10 2a8 8 0 1 0 0 16 8 8 0 0 0 0-16Zm3.7 6.2-4.2 4.2a1 1 0 0 1-1.4 0L6.3 10.6a1 1 0 1 1 1.4-1.4l1.1 1.1 3.5-3.5a1 1 0 1 1 1.4 1.4Z" />
        </svg>
        <%= flash[:notice] %>
      </div>
    <% end %>

    <main class="px-4 pb-20">
      <%= yield %>
    </main>
  </body>
</html>
