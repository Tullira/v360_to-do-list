<div class="mx-auto mt-10 w-full max-w-md">
  <nav class="mb-4 flex items-center gap-2 text-sm text-slate-500">
    <%= link_to "Minhas listas", lists_path, class: "hover:text-slate-900" %>
    <span aria-hidden="true">/</span>
    <%= link_to @list.name, list_path(@list), class: "truncate hover:text-slate-900" %>
  </nav>

  <div class="card p-6">
    <h1 class="text-xl font-semibold tracking-tight text-slate-900">Editar tarefa</h1>

    <%= form_with model: [ @list, @task ], url: list_task_path(@list, @task), method: :patch,
                  class: "mt-6 space-y-4" do |f| %>
      <%= render "shared/errors", record: @task %>
      <%= hidden_field_tag :return_to, "task" %>

      <div>
        <%= f.label :title, "Titulo", class: "field-label" %>
        <%= f.text_field :title, class: "field" %>
      </div>

      <div>
        <%= f.label :description, "Descricao", class: "field-label" %>
        <%= f.text_area :description, rows: 4, class: "field" %>
      </div>

      <div>
        <%= f.label :due_date, "Prazo", class: "field-label" %>
        <%= f.date_field :due_date, class: "field" %>
      </div>

      <div class="flex items-center justify-end gap-2 pt-2">
        <%= link_to "Cancelar", list_task_path(@list, @task), class: "btn btn-secondary" %>
        <%= f.submit "Salvar", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</div>
