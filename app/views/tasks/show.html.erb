<div class="page">
  <%= render "shared/breadcrumb",
             trail: [ [ "Minhas listas", lists_path ], [ @list.name, list_path(@list) ] ] %>

  <article class="card p-6 sm:p-7">
    <header class="flex items-start justify-between gap-4">
      <h1 class="<%= class_names("text-2xl font-semibold tracking-tight",
                                 "text-fg-subtle line-through" => @task.completed?,
                                 "text-fg" => !@task.completed?) %>">
        <%= @task.title %>
      </h1>

      <% if @task.completed? %>
        <span class="badge badge-success" data-task-status="completed">Feita</span>
      <% else %>
        <span class="badge badge-warning" data-task-status="pending">Pendente</span>
      <% end %>
    </header>

    <section class="mt-6">
      <h2 class="section-label">Descricao</h2>
      <% if @task.description.present? %>
        <%# max-w em ch: linha longa demais faz o olho perder a proxima. %>
        <p class="mt-2 max-w-[65ch] whitespace-pre-line text-fg"><%= @task.description %></p>
      <% else %>
        <p class="mt-2 italic text-fg-subtle">Sem descricao</p>
      <% end %>
    </section>

    <dl class="divider mt-6 grid grid-cols-1 gap-4 pt-6 text-sm sm:grid-cols-2">
      <div>
        <dt class="section-label">Prazo</dt>
        <dd class="mt-1.5">
          <% if @task.due_date.present? %>
            <%= render "shared/task_due_date", date: @task.due_date, completed: @task.completed? %>
          <% else %>
            <span class="text-fg-muted">Sem prazo</span>
          <% end %>
        </dd>
      </div>

      <div>
        <dt class="section-label">Criada em</dt>
        <dd class="mt-1.5 text-fg-muted"><%= l @task.created_at.to_date, format: :long %></dd>
      </div>
    </dl>

    <div class="divider mt-6 flex flex-wrap items-center justify-between gap-4 pt-6">
      <%= form_with model: [ @list, @task ], url: list_task_path(@list, @task), method: :patch,
                    class: "flex items-center gap-2" do |f| %>
        <%# return_to e um token fixo, nunca uma URL do cliente: aceitar uma URL
            aqui abriria redirecionamento aberto. Ver TasksController. %>
        <%= hidden_field_tag :return_to, "task" %>
        <%= f.check_box :completed,
              id: "task_completed",
              onchange: "this.form.requestSubmit()",
              class: "checkbox" %>
        <%= f.label :completed, "Concluida", for: "task_completed",
              class: "cursor-pointer text-sm text-fg" %>
      <% end %>

      <div class="flex items-center gap-2">
        <%= link_to "Editar", edit_list_task_path(@list, @task), class: "btn btn-secondary btn-sm" %>
        <%= button_to "Excluir tarefa", list_task_path(@list, @task), method: :delete,
              form_class: "inline-block", class: "btn btn-danger" %>
      </div>
    </div>
  </article>
</div>
